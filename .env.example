# Vorlage für die Umgebungsvariablen.
# Lokal: diese Datei nach .env.local kopieren und die Werte eintragen.
# Vercel: Die Integrationen "MongoDB Atlas" und "Clerk" aus dem Vercel Marketplace
#         tragen die Pflicht-Variablen automatisch ein. Von Hand nur, wenn man
#         die Dienste direkt (ohne Vercel) nutzt.
# Echte Werte gehören NIE in Git (.env* ausser dieser Vorlage ist in .gitignore).

# --- MongoDB Atlas (Pflicht) ---
# Setzt die Vercel-Integration automatisch. Von Hand: Atlas -> Connect -> Drivers.
# Der Datenbankname "devFlow" wird im Code gesetzt (lib/mongoose.ts).
# (Der alte Name MONGODB_URL funktioniert auch noch.)
MONGODB_URI=

# --- Clerk (Pflicht) ---
# Setzt die Vercel-Integration automatisch. Von Hand: Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Clerk-Webhook (optional) ---
# Neue Accounts werden auch ohne Webhook beim ersten Besuch angelegt.
# Der Webhook überträgt zusätzlich Namensänderungen und gelöschte Accounts.
# Clerk Dashboard -> Webhooks -> Endpoint ".../api/webhook" -> Signing Secret (whsec_...)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- OpenAI (optional) ---
# Nur nötig für den Knopf "Generate AI Answer". Ohne Key wird der Knopf ausgeblendet.
OPENAI_API_KEY=
# Optional: anderes Modell (Standard: gpt-4o-mini)
OPENAI_MODEL=

# Hinweis: Der Editor (TinyMCE) ist selbst gehostet und braucht keinen API-Key mehr.
